# ==============================================================================
# MAS AI Labs — Slack Standup Bot Configuration (.env)
# ==============================================================================

# Slack Authentication Tokens (Obtain from https://api.slack.com/apps)
SLACK_BOT_TOKEN="xoxb-your-bot-user-oauth-token"
SLACK_APP_TOKEN="xapp-your-app-level-token-for-socket-mode"
SLACK_SIGNING_SECRET="your-slack-signing-secret"

# Main Group Channel & Standup Google Meet URL
SLACK_STANDUP_CHANNEL="#all-mas-ai-labs"
GOOGLE_MEET_URL="https://meet.google.com/iek-smrh-zgg?authuser=0&hl=en_GB"

# Teammates Slack User IDs (Right click profile in Slack -> Copy Member ID)
SLACK_ID_GAURAV="U01XXXXXXXX"
SLACK_ID_SHUBHAM="U02XXXXXXXX"
SLACK_ID_ROHAN="U03XXXXXXXX"
SLACK_ID_PRAKHAR="U04XXXXXXXX"
SLACK_ID_YASHVI="U05XXXXXXXX"
SLACK_ID_QA="U06XXXXXXXX"
SLACK_ID_INTERN="U07XXXXXXXX"

# Standup Schedule (Times in IST)
DM_TRIGGER_TIME="19:00"        # 7:00 PM IST (Dispatches personal DMs)
DIGEST_TRIGGER_TIME="19:45"    # 7:45 PM IST (Pre-standup digest in #all-mas-ai-labs)
STANDUP_CALL_TIME="20:00"      # 8:00 PM IST (Google Meet Standup Call)
