{
  "display_information": {
    "name": "MAS Standup Bot",
    "description": "Automated Standup Coordinator & Sprint Sync Bot for MAS AI Labs",
    "background_color": "#111827"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "MAS Standup",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/standup",
        "description": "Trigger your quick 1-minute daily standup update",
        "should_escape": false
      },
      {
        "command": "/standup-notes",
        "usage_hint": "[paste Google Meet Gemini summary]",
        "description": "Post Day Highlights and sync decisions to Sprint doc",
        "should_escape": false
      },
      {
        "command": "/sprint-summary",
        "description": "Generate and post the current sprint summary",
        "should_escape": false
      },
      {
        "command": "/sprint-rollover",
        "usage_hint": "[from_sprint] [to_sprint]",
        "description": "Roll over incomplete tasks to the next sprint",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "commands",
        "im:write",
        "im:history",
        "im:read",
        "users:read",
        "channels:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "socket_mode_enabled": true,
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false
  }
}
